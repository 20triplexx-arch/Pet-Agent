# copy to .env in repository root; never put model secrets in VITE_* variables
PROJECT_NAME=宠伴
DATABASE_URL=sqlite:///./storage/chongban.db
SECRET_KEY=
DEMO_MODE=true
MODEL_PROVIDER=compatible
# DeepSeek: set MODEL_PROVIDER=deepseek and DEMO_MODE=false.
# Read DEEPSEEK_API_KEY from the server environment; do not copy secrets into source.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 阿里百炼：本机设 MODEL_PROVIDER=alibaba、DEMO_MODE=false。
# 从服务端环境读取 DASHSCOPE_API_KEY，不复制密钥到前端或源码。
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# 显式地址优先；否则使用上述业务空间的北京地址，无业务空间时使用北京公共地址。
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=qwen3.7-flash
# 自动池只接受已核实剩余免费额度、用完即停且通过本版质量核验的模型。
# 分发仍默认演示；本机启用自动选择时设 true。
DASHSCOPE_AUTO_SELECT=false
DASHSCOPE_FREE_ONLY=true
DASHSCOPE_FREE_MODELS=qwen-flash,qwen3.7-flash-2026-07-15,qwen3.8-flash,qwen3.7-flash
DASHSCOPE_QUOTA_FILE=./storage/alibaba-quota.json
DASHSCOPE_QUALIFIED_FILE=./storage/alibaba-qualified.json
DASHSCOPE_QUOTA_MAX_AGE_SECONDS=180
# 独立官方 CLI 登录仅读取额度/维护用完即停，不替换后端推理 Key。
DASHSCOPE_CLI=
DASHSCOPE_CLI_CONFIG_DIR=./storage/bailian-cli
DASHSCOPE_CLI_PROFILE=chongban-quota
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.7-flash
# 本地取消每日问答及单次模型/工具调用次数限制；用量仍统计，真实API按实际用量计费。
MODEL_LIMITS_ENABLED=false
# 以下次数参数在 MODEL_LIMITS_ENABLED=true 时生效；专用评测仍受原预算约束。
MODEL_MAX_REQUESTS=4
MODEL_MAX_OUTPUT_TOKENS=4096
MODEL_MAX_INPUT_TOKENS=32000
MODEL_CONTEXT_CHARS=48000
MODEL_TIMEOUT_SECONDS=90
# 每用户每天真实问答尝试数（上海时区，含失败）；不是供应商余额。
MODEL_TURNS_PER_DAY=20
# 独立地图开关。先确认账号免费资格，再在服务端启用；不自动购买额度。
AMAP_ENABLED=false
AMAP_API_KEY=
# 旧版兼容字段；医院页及省略provider的搜索自动综合可用来源，不按此项单选。
HOSPITAL_MAP_PROVIDER=amap
# 天地图应用类型选择“服务端”。Key仅在后端使用；填入本机.env，不要放VITE_*。
# 医院工具Agent自动结合已启用且有额度的两家资料；分别计费计数，失败不自动重试。
TIANDITU_ENABLED=false
TIANDITU_API_KEY=
TIANDITU_REQUESTS_PER_DAY=50
TIANDITU_REQUESTS_PER_MONTH=500
# 天地图首批接地名搜索v2，周边最多10公里；无星级/营业时间推断。
# 区域候选和静态图使用高德；仅标注高德候选坐标。天地图独有候选按名称打开地图。
MAP_REQUESTS_PER_DAY=50
MAP_REQUESTS_PER_MONTH=500
# 区域候选、医院查询及静态地图都计入上述应用上限；地图使用同一Web服务Key。
# 手填区域或街道/具体地点的地理编码也计数；仅点击查询后匹配，不缓存具体地址。
# 区域只做6小时有界内存缓存，医院地图预览为10分钟私有临时缓存。
# 可选的本地CPU识别。先安装 requirements-ocr.txt；关闭或未安装时可手动输入。
OCR_ENABLED=true
OCR_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
