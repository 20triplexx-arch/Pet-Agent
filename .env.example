# copy to .env in repository root; never put model secrets in VITE_* variables
PROJECT_NAME=宠伴
DATABASE_URL=sqlite:///./storage/chongban.db
SECRET_KEY=
DEMO_MODE=true
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.7-flash
MODEL_MAX_REQUESTS=4
MODEL_MAX_OUTPUT_TOKENS=1800
MODEL_TIMEOUT_SECONDS=35
# 独立地图开关。先确认账号免费资格，再在服务端启用；不自动购买额度。
AMAP_ENABLED=false
AMAP_API_KEY=
MAP_REQUESTS_PER_DAY=50
MAP_REQUESTS_PER_MONTH=500
# 可选的本地CPU识别。先安装 requirements-ocr.txt；关闭或未安装时可手动输入。
OCR_ENABLED=true
OCR_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
