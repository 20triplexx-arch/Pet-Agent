  {
    "id": "dog-home",
    "title": "幼犬到家：安全空间与一致的规则",
    "topic": "新宠到家",
    "species": [
      "dog"
    ],
    "body": "提前安排兽医与采用人道方法的训练支持，了解幼犬既往饮食与经历。移除危险物品，设置有人陪伴监督的安全区域；家庭成员统一作息与规则。用奖励引导行为，为适应期留出时间。",
    "keywords": [
      "到家",
      "幼犬",
      "适应",
      "新狗",
      "训练"
    ],
    "source_organization": "AAHA",
    "source_url": "https://www.aaha.org/resources/what-to-do-before-you-bring-home-a-new-puppy/",
    "source_version": "网页 2026-06-05",
    "published_at": "2026-06-05",
