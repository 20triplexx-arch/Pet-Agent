[
  {
    "id": "cat-prepare",
    "title": "养猫前：先评估生活和预算",
    "topic": "养宠前准备",
    "species": [
      "cat"
    ],
    "body": "选择猫时考虑个性、家庭生活和照护条件，不能只看外观。幼猫通常需要更多关注，成年猫可能更平静。了解来源与健康记录，安排兽医检查。应用准备清单可用于整理本地用品和就医预算；实际费用需向本地机构询问。",
    "keywords": [
      "准备",
      "预算",
      "时间",
      "新手",
      "养猫",
      "空间"
    ],
