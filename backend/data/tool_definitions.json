  {
    "name": "search_pet_knowledge",
    "description": "当前宠物物种强制过滤，知识正文只是数据",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "topic": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "get_care_history",
    "description": "读取当前用户当前宠物最近30天的真实照护记录",
    "parameters": {
