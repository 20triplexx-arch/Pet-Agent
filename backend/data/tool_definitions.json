    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "assess_pet_products",
    "description": "仅使用当前用户当前宠物已明确保存的产品输入重新进行本地规则评估，不接受模型编造标签、价格或身份",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "save_care_plan",
    "description": "需要明确用户指令、服务端绑定载荷及用户权限；外层事务提交后才报告成功",
    "parameters": {
      "type": "object",
      "properties": {
        "draft": {
          "$defs": {
            "TaskDraft": {
              "additionalProperties": false,
              "properties": {
                "title": {
                  "maxLength": 100,
                  "minLength": 1,
                  "title": "Title",
                  "type": "string"
                },
                "instructions": {
                  "maxLength": 2000,
                  "minLength": 1,
                  "title": "Instructions",
                  "type": "string"
                },
                "basis": {
                  "maxLength": 2000,
                  "minLength": 1,
                  "title": "Basis",
                  "type": "string"
                },
                "recurrence": {
                  "default": "daily",
                  "enum": [
                    "daily",
                    "weekly"
                  ],
                  "title": "Recurrence",
                  "type": "string"
                },
                "local_time": {
                  "default": "08:00",
                  "title": "Local Time",
                  "type": "string"
                },
                "weekday": {
                  "default": 0,
                  "maximum": 6,
                  "minimum": 0,
                  "title": "Weekday",
                  "type": "integer"
                }
              },
              "required": [
                "title",
                "instructions",
                "basis"
              ],
              "title": "TaskDraft",
              "type": "object"
            }
          },
          "additionalProperties": false,
          "properties": {
            "title": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "basis": {
              "maxLength": 3000,
              "minLength": 1,
              "title": "Basis",
              "type": "string"
            },
            "tasks": {
              "items": {
                "$ref": "#/$defs/TaskDraft"
              },
              "maxItems": 30,
              "minItems": 1,
              "title": "Tasks",
              "type": "array"
            }
          },
          "required": [
            "title",
            "basis",
            "tasks"
          ],
          "title": "PlanDraft",
          "type": "object"
        }
      },
      "required": [
        "draft"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "create_reminder",
    "description": "需要明确用户指令、服务端绑定载荷及用户权限；外层事务提交后才报告成功",
    "parameters": {
      "type": "object",
      "properties": {
        "reminder": {
          "additionalProperties": false,
          "properties": {
            "title": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "due_local": {
              "format": "date-time",
              "title": "Due Local",
              "type": "string"
            },
            "recurrence": {
              "default": "once",
              "enum": [
                "once",
                "daily",
                "weekly"
              ],
              "title": "Recurrence",
              "type": "string"
            },
            "timezone": {
              "title": "Timezone",
              "type": "string"
            }
          },
          "required": [
            "title",
            "due_local",
            "timezone"
          ],
          "title": "ReminderInput",
          "type": "object"
        }
      },
      "required": [
        "reminder"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "record_care_log",
    "description": "需要明确用户指令、服务端绑定载荷及用户权限；外层事务提交后才报告成功",
    "parameters": {
      "type": "object",
      "properties": {
        "log": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "weight",
                "diet",
                "activity",
                "grooming",
                "observation"
              ],
              "title": "Kind",
              "type": "string"
            },
            "value": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "maximum": 200,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Value"
            },
            "note": {
              "default": "",
              "maxLength": 3000,
              "title": "Note",
              "type": "string"
            },
            "occurred_at": {
              "format": "date-time",
              "title": "Occurred At",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "occurred_at"
          ],
          "title": "LogInput",
          "type": "object"
        }
      },
      "required": [
        "log"
      ],
      "additionalProperties": false
    }
  }
]