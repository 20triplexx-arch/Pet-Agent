    }
  },
  {
    "name": "get_current_care_plans",
    "description": "读取当前宠物的执行中计划",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "assess_nutrition",
    "description": "使用已保存营养资料和后端确定性规则评估，不允许模型指定数值",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "search_nearby_hospitals",
    "description": "返回医院查询入口；用户在独立页面授权定位或填写区域后才调用地图接口",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "build_vet_visit_summary",
    "description": "根据当前宠物真实档案及记录生成可编辑的就医资料，不作诊断",
